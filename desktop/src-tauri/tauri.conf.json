{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CT Gruppenhierarchie",
  "mainBinaryName": "ct-gruppenhierarchie",
  "version": "0.1.0",
  "identifier": "io.github.tihohub.ctgruppenhierarchie",
  "build": {
    "frontendDist": "../../dist/webseite"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CT Gruppenhierarchie",
        "width": 1300,
        "height": 900,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Gruppenhierarchie einer CT-Instanz anzeigen (nur lesend)",
    "copyright": "© 2026 Tim Hofmann",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ]
      }
    },
    "resources": {
      "../THIRD_PARTY_RUST_LICENSES.txt": "lizenzen/THIRD_PARTY_RUST_LICENSES.txt",
      "../../LICENSE.txt": "lizenzen/LICENSE.txt",
      "../../THIRD_PARTY_LICENSES.txt": "lizenzen/THIRD_PARTY_LICENSES.txt"
    }
  }
}
